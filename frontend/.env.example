# Supabase (optional - used only by legacy data features, never by self-hosted authentication)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SIP Configuration (SignalWire, Telnyx, Twilio, or any SIP provider)
VITE_SIP_URI=sip:your-extension@your-domain.sip.signalwire.com
VITE_SIP_PASSWORD=your-sip-password
VITE_SIP_WS_URL=wss://your-domain.sip.signalwire.com
VITE_SIP_CALLER_ID=+1XXXXXXXXXX

# Self-hosted backend. Leave blank when the frontend and API share an origin.
VITE_API_URL=

# UI-only control for the public registration link/route. The backend is authoritative.
VITE_ALLOW_PUBLIC_SIGNUP=false
